#!/usr/bin/env python3
"""The fake-CLI test rig: a stub executable standing in for the codex or
claude binary, so spawn/stream/classify/repair are tested end to end with
zero tokens (build plan, stage 3).

The adapters reach it through their binary overrides (RUNNER_CODEX_CLI /
RUNNER_CLAUDE_CLI). Behavior is scripted per invocation:

- FAKE_CLI_SCENARIO — path to a JSON list; element N drives call N (the
  last element repeats when calls outnumber elements). Each element:
    {"emit": [ ...JSON objects printed to stdout as JSONL... ],
     "stderr": "text",
     "write": [{"path": "...", "text": "..."}],
     "sleep": seconds,
     "exit": code}
- FAKE_CLI_CALLS — a directory where every invocation records itself as
  call-NN.json ({"argv": [...], "stdin": "...", "env": {...}}), so tests
  can assert command shapes (resume/followup), the delivered prompt, and
  the isolated environment.

stdin is always consumed fully before the scenario plays, matching the
real CLIs' prompt-on-stdin contract.
"""

import json
import os
import sys
import time


def main() -> None:
    calls_dir = os.environ.get("FAKE_CLI_CALLS")
    scenario_path = os.environ.get("FAKE_CLI_SCENARIO")
    scenario = []
    if scenario_path and os.path.exists(scenario_path):
        with open(scenario_path) as fh:
            scenario = json.load(fh)

    count = 0
    if calls_dir:
        os.makedirs(calls_dir, exist_ok=True)
        counter = os.path.join(calls_dir, "count")
        if os.path.exists(counter):
            with open(counter) as fh:
                count = int(fh.read().strip() or 0)
        with open(counter, "w") as fh:
            fh.write(str(count + 1))

    stdin_text = sys.stdin.read()

    if calls_dir:
        record = {
            "argv": sys.argv[1:],
            "stdin": stdin_text,
            "env": dict(os.environ),
        }
        with open(os.path.join(calls_dir, f"call-{count:02d}.json"), "w") as fh:
            json.dump(record, fh, indent=2, sort_keys=True)

    call = {}
    if scenario:
        call = scenario[count] if count < len(scenario) else scenario[-1]

    for payload in call.get("emit", []):
        sys.stdout.write(json.dumps(payload) + "\n")
        sys.stdout.flush()
    if call.get("stderr"):
        sys.stderr.write(call["stderr"])
        sys.stderr.flush()
    for item in call.get("write", []):
        directory = os.path.dirname(item["path"])
        if directory:
            os.makedirs(directory, exist_ok=True)
        with open(item["path"], "w") as fh:
            fh.write(item["text"])
    if call.get("sleep"):
        time.sleep(float(call["sleep"]))
    sys.exit(int(call.get("exit", 0)))


if __name__ == "__main__":
    main()
